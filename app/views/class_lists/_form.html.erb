<%= form_with(model: class_list) do |form| %>
  <% if class_list.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(class_list.errors.count, "error") %> prohibited this class_list from being saved:</h2>

      <ul>
        <% class_list.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :student_id, "Student", style: "display: block" %>
    <%= form.collection_select :student_id, Student.order(:name), :id, :name, { prompt: "Select Student" } %>
  </div>

  <div>
    <%= form.label :section_id, "Section", style: "display: block" %>
    <%= form.collection_select :section_id, Section.order(:name), :id, :name, { prompt: "Select Section" } %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>